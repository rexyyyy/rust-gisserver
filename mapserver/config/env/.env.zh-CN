# rust-gisserver and rust-gisserver environment configuration
# Region preset: Simplified Chinese / GBK
# Copy this file to .env and modify as needed
# Full list of region presets: config/env/README.md
#
# Legacy filename encoding region used by path normalisation.
# Valid values: zh-CN / zh-TW / en / ko / ja
# Linux and macOS have no equivalent of the Windows ANSI code page,
# so this must be set explicitly. Default when unset: zh-CN
GIS_ENCODING_REGION=zh-CN
#
# ==== REQUIRED: no default in config XML ====
# manager DSN password (config/manager/manager.xml)
MANAGER_DB_PASSWORD=change-me
# manager JWT signing secret (generate: openssl rand -hex 32)
MANAGER_JWT_SECRET=change-me-random-secret
# map-api admin DSN password (config/mapserver.xml)
MAPSERVER_DB_PASSWORD=change-me
#
# ==== OPTIONAL: config XML supplies these defaults ====
MANAGER_DB_HOST=localhost
MANAGER_DB_PORT=5432
MAPSERVER_DB_HOST=localhost
MAPSERVER_DB_PORT=5432
MAPSRV_HOST=127.0.0.1
MAPSRV_PORT=8080
MAPSERVER_MANAGER_URL=http://127.0.0.1:6180
# Data root defaults to the data\ subdirectory next to start-*.bat
# (created by install.bat). Set DATA_ROOT only for an external data drive.
# DATA_ROOT=E:\data\1
#
# e2e conversion fixture root (demo layers only)
# TESTDATA_ROOT=
# Absolute path to shp2pgsql.exe, only needed for SHP import
# SHPPGSQL_BIN=
# PROJ_DLL / PROJ_DATA / PROJ_LIB are set by start-*.bat; do not set here.
# Deprecated, no longer read: MAPSERVER_PORT (use config/mapserver.xml),
#   MAPSERVER_DATA_DIR, MAPSERVER_CACHE_DIR, API_KEY. Data root defaults
#   to data\ and can be overridden with DATA_ROOT.
