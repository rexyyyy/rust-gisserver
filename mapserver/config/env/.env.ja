# rust-gisserver and rust-gisserver environment configuration
# Region preset: Japanese / Shift_JIS
# Copy this file to .env and modify as needed
# Full list of region presets: config/env/README.md
#
# Legacy filename encoding region used by path normalisation.
# Valid values: zh-CN / zh-TW / en / ko / ja
# Linux and macOS have no equivalent of the Windows ANSI code page,
# so this must be set explicitly. Default when unset: zh-CN
GIS_ENCODING_REGION=ja
#
# PostgreSQL database for rust-gisserver
MANAGER_DB_HOST=localhost
MANAGER_DB_PORT=5434
MANAGER_DB_PASSWORD=your_password_here
MANAGER_JWT_SECRET=your_jwt_secret_here
#
# rust-gisserver connection (for rust-gisserver proxy)
MAPSRV_HOST=127.0.0.1
MAPSRV_PORT=8080
#
# rust-gisserver
MAPSERVER_PORT=8080
MAPSERVER_DATA_DIR=data
MAPSERVER_CACHE_DIR=cache
#
# API Key (optional, for auth)
API_KEY=your-secret-key-here
