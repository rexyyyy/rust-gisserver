<?xml version="1.0" encoding="UTF-8"?>
<!--
  rust-gisserver 系统管理后端配置（仅 PostgreSQL）— 探测实例
  =============================================================================
  配置文件为 XML：属性承载标量字段，<item> 是列表元素的通用标记。
-->
<config>
  <!-- 探测实例：仅提供 API，不挂前端静态资源（static_dir 留空） -->
  <server addr="0.0.0.0:6181" base_api="/manager-api">
    <!-- 允许的前端来源（开发态 vite 端口） -->
    <cors_origins>
      <item>http://localhost:5100</item>
      <item>http://127.0.0.1:5100</item>
    </cors_origins>
  </server>
  <database url="postgresql://postgres:${MANAGER_DB_PASSWORD}@${MANAGER_DB_HOST:-localhost}:${MANAGER_DB_PORT:-5434}/mapserver-manager" pool_max="16"/>
  <!-- 头像本地存储根目录（相对后端进程工作目录） -->
  <storage avatar_dir="storage/avatar"/>
  <security jwt_secret="${MANAGER_JWT_SECRET}" token_expire_minutes="1440" captcha_enabled="false">
    <!-- 免鉴权白名单（相对 base_api 的路径） -->
    <white_list>
      <item>/auth/login</item>
      <item>/auth/code</item>
      <item>/captchaImage</item>
    </white_list>
  </security>
</config>
