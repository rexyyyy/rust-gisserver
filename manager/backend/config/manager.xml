<?xml version="1.0" encoding="UTF-8"?>
<!--
  rust-gisserver 系统管理后端配置（仅 PostgreSQL）
  =============================================================================
  配置文件为 XML：属性承载标量字段，<item> 是列表元素的通用标记。
  =============================================================================
  密钥/口令（P0-3）：MANAGER_DB_PASSWORD、MANAGER_JWT_SECRET 经环境变量注入，
  仓库内不含明文；host/port 提供非敏感默认值（localhost:5434 / 127.0.0.1:8080）。
  本地运行前 set 这两个环境变量即可（容器由 deploy compose 自动注入）。
-->
<config>
  <server addr="0.0.0.0:6180" base_api="/manager-api" static_dir="manager/ui/dist">
    <!-- 允许的前端来源（开发态 vite 端口） -->
    <cors_origins>
      <item>http://localhost:5100</item>
      <item>http://127.0.0.1:5100</item>
    </cors_origins>
  </server>
  <database url="postgresql://postgres:${MANAGER_DB_PASSWORD}@${MANAGER_DB_HOST:-localhost}:${MANAGER_DB_PORT:-5434}/mapserver_manager" pool_max="16"/>
  <!-- 头像本地存储根目录。相对路径按后端进程工作目录解析；
       生产部署建议改绝对路径（如 /var/lib/rust-gisserver/avatar），便于挂数据盘。 -->
  <storage avatar_dir="storage/avatar"/>
  <!-- map-api（rust-gisserver 服务面）管理代理 -->
  <mapsvc base_url="http://${MAPSRV_HOST:-127.0.0.1}:${MAPSRV_PORT:-8080}"/>
  <security jwt_secret="${MANAGER_JWT_SECRET}" token_expire_minutes="1440" captcha_enabled="false">
    <!-- 免鉴权白名单（相对 base_api 的路径） -->
    <white_list>
      <item>/auth/login</item>
      <item>/auth/code</item>
      <item>/captchaImage</item>
    </white_list>
  </security>
</config>
