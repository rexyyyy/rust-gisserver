# ============================================================================
# rust-gisserver 数据底座 · 一键部署环境变量样例（P0-1 / P0-3）
#
# 用法：copy .env.example .env  然后填写下列值；.env 已在 .gitignore 中，
# 不入库。compose 自动读取同目录 .env，两个服务 entrypoint 用 envsubst
# 把这些变量渲染进容器配置模板 config/**.xml —— 明文密钥只活在运行环境里。
# ============================================================================
#
# 必需：MANAGER_JWT_SECRET（compose 用 :? 强校验，未设置直接拒绝启动）。
# 其余项均有默认值：PG 账号默认 postgres / 123456（本机开发口径，改密/换用户
# 覆盖 POSTGRES_USER / MAPSERVER_DB_PASSWORD 即可），gisdata 默认 ./gisdata。
# 口径差异：容器内 manager DSN 复用 MAPSERVER_DB_PASSWORD，host 固定
#       postgis:5432，data_root 固定 /app/data（对应 gisdata 挂载点），因此这里
#       不需要 MANAGER_DB_PASSWORD / DATA_ROOT。本地安装的必需项清单见
#       build/script/README.md §3.3。
# ============================================================================

# PostGIS 超级用户名（默认 postgres，可与本机现有实例口径一致）
POSTGRES_USER=postgres

# PostGIS 超级用户口令：同时用于 DB 初始化与两服务 DSN 注入
# （compose 默认 123456 = 本机开发口径；共享环境务必改强口令）
MAPSERVER_DB_PASSWORD=change-me-strong-password

# rust-gisserver JWT 签名密钥：务必换成随机长串（例如 openssl rand -hex 32）
MANAGER_JWT_SECRET=change-me-random-64-bytes-secret

# DSN 落库加密密钥（可选）：sys_store.pg_dsn 默认用 DES 加密，可改为 SM4
# （manager.xml 的 security.dsn_cipher）。留空时由 MANAGER_JWT_SECRET 派生；
# 共享环境建议显式设置并妥善保管，改密钥后旧密文将无法解密。
# MANAGER_DSN_KEY=change-me-random-32-bytes-key

# PostGIS 暴露到宿主机的端口（沿用仓库既有 5432，避开本机默认 5432）
MAPSERVER_DB_PORT=5432

# gisdata 数据挂载点（宿主目录）：只挂到 map-api 的 /app/data（只读）；
# manager 不挂数据卷，所有数据操作经 map-api 接口执行。默认工作区 ws1 的
# data_root 即此目录。默认 ./gisdata（相对部署目录，compose 启动时自动创建）；
# 指向外置盘时 Windows 路径请用正斜杠。
# GISDATA_DIR=E:/data/gisdata

# ---------------------------------------------------------------------------
# data_root（P0-4 去机器化）：图层配置文件已改用占位，不再写死盘符。
#   - 容器：map-api 模板已固定 data_root=/app/data（对应 gisdata 挂载点），无需在此配。
#   - 本地安装 / cargo run：config/mapserver.xml 写 ${DATA_ROOT:-data}，
#     默认取启动工作目录下的 data/ 子目录（安装脚本已创建，源码树有 .gitkeep），
#     无需配置 DATA_ROOT。仅当数据放在外置盘时按需注入（PowerShell 会话）：
#         $env:DATA_ROOT     = 'E:\data\1'
#         $env:TESTDATA_ROOT = 'D:\mycomputor\documents\gis-wt\.testdata'
#     TESTDATA_ROOT 未设置时相关 e2e demo 图层会被跳过（告警，非致命）。
# ---------------------------------------------------------------------------
# DATA_ROOT=E:\data\1
# TESTDATA_ROOT=D:\mycomputor\documents\gis-wt\.testdata
