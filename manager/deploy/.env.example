# ============================================================================
# rust-gisserver 数据底座 · 一键部署环境变量样例（P0-1 / P0-3）
#
# 用法：copy .env.example .env  然后填写下列值；.env 已在 .gitignore 中，
# 不入库。compose 自动读取同目录 .env，两个服务 entrypoint 用 envsubst
# 把这些变量渲染进容器配置模板 config/**.xml —— 明文密钥只活在运行环境里。
# ============================================================================
#
# 必需：MAPSERVER_DB_PASSWORD / MANAGER_JWT_SECRET（compose 用 :? 强校验，
#       未设置直接拒绝启动）；其余项均有默认值或仅供本地开发注入。
# 口径差异：容器内 manager DSN 复用 MAPSERVER_DB_PASSWORD，host 固定
#       postgis:5432，data_root 固定 /app/data（对应 ./data 卷），因此这里
#       不需要 MANAGER_DB_PASSWORD / DATA_ROOT。本地安装的必需项清单见
#       build/script/README.md §3.3。
# ============================================================================

# PostGIS 超级用户口令：同时用于 DB 初始化与两服务 DSN 注入
MAPSERVER_DB_PASSWORD=change-me-strong-password

# rust-gisserver JWT 签名密钥：务必换成随机长串（例如 openssl rand -hex 32）
MANAGER_JWT_SECRET=change-me-random-64-bytes-secret

# PostGIS 暴露到宿主机的端口（沿用仓库既有 5434，避开本机默认 5432）
MAPSERVER_DB_PORT=5434

# ---------------------------------------------------------------------------
# data_root（P0-4 去机器化）：图层配置文件已改用占位，不再写死盘符。
#   - 容器：map-api 模板已固定 data_root=/app/data（对应 ./data 卷），无需在此配。
#   - 本地直接 cargo run map-api：需把下面两个变量注入进程环境（PowerShell 会话）：
#         $env:DATA_ROOT       = 'E:\data\1'
#         $env:TESTDATA_ROOT   = 'D:\mycomputor\documents\gis-wt\.testdata'
#     未设置时 ${DATA_ROOT}/${TESTDATA_ROOT} 展开为空 -> 相关 demo 图层会被跳过（告警）。
# ---------------------------------------------------------------------------
DATA_ROOT=E:\data\1
TESTDATA_ROOT=D:\mycomputor\documents\gis-wt\.testdata
