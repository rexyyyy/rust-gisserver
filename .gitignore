# ===== Build output =====
# cargo target dir is redirected here by build/script/build_all.bat (CARGO_TARGET_DIR).
# Scripts in build/script/ are source and stay tracked; only build/target/ is ignored.
/build/target/
/mapserver/target/
/manager/target/

# ===== Agent / runtime artifacts (never commit) =====
# WorkBuddy agent memory, skills cache, and session logs stay local.
.workbuddy/

# ===== Build logs =====
# Generated by build/script/build_all.bat; never commit.
/build_mapserver.log

# ===== Duplicate of build/script/PROJ_RUNTIME_MANIFEST.csv =====
# The authoritative copy lives in build/script/. This on-disk copy under
# mapserver/install/windows/ is kept only locally to avoid confusion.
/mapserver/install/windows/PROJ_RUNTIME_MANIFEST.csv

# ===== Local run environment / caches (never commit) =====
# build/script/install.bat deploys into <repo>/run-env: 20+ GB of COG / 3D Tiles
# data, an 8 GiB foyer cache, generated bin/ and web/, and .env with real
# DB passwords / JWT secrets. It is a runtime artifact, not source.
/run-env/
/cache/
# Scratch workspaces used to rebuild the OpenLayers vendor bundle.
/build/_tmp_*/

# ===== Default data root (relative to the map-api working directory) =====
# mapserver/config/mapserver.xml defaults to "data", i.e. <install_dir>/data
# in an installed layout and mapserver/data when running from source.
# Only the placeholder is tracked; real imagery / tiles must never be committed.
/mapserver/data/*
!/mapserver/data/.gitkeep

# ===== Local-only layer configs (contain plaintext DSN passwords) =====
# Authoritative examples live in mapserver/config/*/README.md; the postgis/
# layer files are machine-local test fixtures with hardcoded credentials.
/mapserver/config/postgis/
# Same fixtures land in the repo root when map-api is run from there (its
# default catalog root is "config"): config/postgis/*.xml embeds a plaintext
# DSN password, so it must stay local too.
/config/postgis/

# ===== Local packaging outputs (never commit) =====
# Deployment bundles and ad-hoc doc archives produced by local build scripts.
/dist/
/manager/deploy.zip

# ===== One-off i18n migration scratch (never commit) =====
# Dumps, translation batches and generator scripts used while translating
# Chinese source comments and building the bilingual catalogs. Local only;
# the tracked tooling lives in manager/tools/ and manager/ui/scripts/.
/all_lines.txt
/all_remaining_lines.txt
/missing_lines.txt
/remaining.json
/remaining_by_file.txt
/trades_template.txt
/extract_all.js
/gen_safe_v3.js
/gen_template.js
/safe_v3.js
/trans_catalog.js
/trans_xmlcfg.js
/translate_all.js
/translate_rs_comments.js
/translations_batch1.json
/translations_batch2.json
/manager_err.log
/manager_out.log
/manager/ui/_i18n_map_*.py

# Ad-hoc audit output from pre-commit verification runs.
/_fmt_err.txt
/manager/ui/_i18n_*_out.txt
/manager/backend/_i18n_cargo_test.txt

# ===== Full-test run artifacts (never commit) =====
# 2026-11-12/ holds a 13 GB full test run: build/test logs, scratch scripts
# and CSV inventories, some with machine-local paths and plaintext secrets.
# Only the four Chinese reports under outputs/ were force-added on purpose;
# ignore rules do not affect files already tracked.
/2026-11-12/
